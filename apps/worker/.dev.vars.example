# Copy to .dev.vars and fill in real values for local development (`wrangler dev`).
# Committing keys is forbidden. Production secrets are set via `npx wrangler secret put`.
# Values below match the production defaults in wrangler.jsonc / src/workflows/ai-output.ts.

# REQUIRED for local AI calls (at least one must be set; production uses all three):
NVIDIA_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# OPTIONAL overrides (safe to leave empty; code falls back to these same defaults):
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-large-latest
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_MS=1000