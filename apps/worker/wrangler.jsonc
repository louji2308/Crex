{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crex-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "vars": {
    "NVIDIA_BASE_URL": "https://integrate.api.nvidia.com/v1",
    "NVIDIA_MODEL": "meta/llama-3.3-70b-instruct",
    "MISTRAL_BASE_URL": "https://api.mistral.ai/v1",
    "MISTRAL_MODEL": "mistral-large-latest",
    "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
    "OPENROUTER_MODEL": "meta-llama/llama-3.3-70b-instruct",
    "AI_TIMEOUT_MS": "60000",
    "AI_MAX_RETRIES": "2",
    "AI_RETRY_BASE_DELAY_MS": "1000",
    "SOURCE_MAX_SIZE_BYTES": "104857600"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crex",
      "database_id": "b01526fc-40b4-4024-8616-b2fb6099d94d",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "crex-media"
    }
  ],
  "workflows": [
    {
      "name": "crex-source-to-release",
      "binding": "SOURCE_TO_RELEASE",
      "class_name": "SourceToReleaseWorkflow"
    }
  ]
}
