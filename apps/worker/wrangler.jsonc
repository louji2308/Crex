{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crex-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crex",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "crex-media"
    }
  ],
  "workflows": [
    {
      "name": "crex-source-to-release",
      "binding": "SOURCE_TO_RELEASE",
      "class_name": "SourceToReleaseWorkflow"
    }
  ]
}
