# AI provider credentials (OpenAI-compatible chat completions).
# NAMES ONLY — never commit real values. Production secrets are set via `wrangler secret put`.
# At least one key is required for live AI calls; the worker needs all three to use its
# NVIDIA -> OpenRouter -> (Mistral legacy) fallback chain.
NVIDIA_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Speech-to-text (STT) overrides for POST /ai/understand (names only — optional; code defaults apply:
# mistral / voxtral-mini-2505 / openai/whisper-large-v3).
STT_PRIMARY_PROVIDER=
STT_MISTRAL_MODEL=
STT_OPENROUTER_MODEL=